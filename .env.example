# Local development configuration.
#
# Copy to .env (gitignored) and adjust as needed:
#   cp .env.example .env
#
# These values are for local development only and are not secrets. Every variable
# has a matching default in deploy/compose/docker-compose.yml, so .env is optional.
# Pass it to compose explicitly from the repo root:
#   docker compose --env-file .env -f deploy/compose/docker-compose.yml up -d

# ---- Postgres (deploy/compose) ----
# Database created on first start of the container.
POSTGRES_DB=almanac
# Superuser created on first start. Changing these after the volume exists has no
# effect; remove the volume (docker compose down -v) to re-initialize.
POSTGRES_USER=almanac
POSTGRES_PASSWORD=almanac
# Host port bound on 127.0.0.1. Change it if 5432 is already in use.
POSTGRES_PORT=5432

# ---- Ollama (deploy/compose) ----
# Host port bound on 127.0.0.1. Change it if 11434 is already in use.
OLLAMA_PORT=11434
# Models downloaded by the ollama-pull service on startup.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
